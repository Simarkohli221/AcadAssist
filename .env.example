# SQLite location for user accounts and server-side sessions
AUTH_DATABASE_PATH=data/auth.sqlite3

# Public app URL used to build email verification links
AUTH_PUBLIC_BASE_URL=http://127.0.0.1:8000

# SMTP is required for registration. Use TLS on port 587 or SSL on port 465.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_FROM=
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_USE_SSL=false

# Set true when serving over HTTPS in production; leave false for local HTTP.
AUTH_COOKIE_SECURE=false

# Local-only development: skips email verification for loopback requests.
# This does not prove email ownership. Keep false for any hosted deployment.
AUTH_LOCAL_MODE=false